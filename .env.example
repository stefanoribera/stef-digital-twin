# Copiar a .env y rellenar con valores generados. NUNCA commitear .env.
# Generar cada secreto con:  openssl rand -base64 32

POSTGRES_USER=stef_admin
POSTGRES_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_32
POSTGRES_DB=synchrotron_telemetry

# Puerto de Postgres en el host. Se publica SOLO en 127.0.0.1 (ver compose).
POSTGRES_PORT_EXT=5440

# Password del broker Redis (antes no tenia ninguno)
REDIS_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_32

# Clave de la ruta de escritura POST /collision
INGEST_API_KEY=CAMBIAR_generar_con_openssl_rand_base64_32

# Tope de la cola de ingesta antes de devolver 503
MAX_QUEUE_DEPTH=100000
